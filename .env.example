# Years at FLAME Photoshoot Check-In — Configuration
# Copy this file to .env (never commit .env to GitHub)

# 1. Turso DB (leave blank to store locally in registrations.jsonl + registrations.xlsx)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Admin password (leave blank to auto-generate a random password on local startup)
ADMIN_PASSWORD=

# 3. Optional constant public URL override (auto-detected on Vercel)
PUBLIC_URL=

# 4. Server port (local runs only, default 5000)
PORT=5000

# 5. Optional photocode regex (default: 3 to 30 non-space characters)
# Example: PHOTOCODE_PATTERN=[A-Z]{2}\d{4}
PHOTOCODE_PATTERN=
